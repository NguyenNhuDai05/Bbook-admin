# Server-only address. Do not prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:5261/api
APP_ORIGIN=http://localhost:3001
# Use the same API address configured for the existing application.
# No fallback URL is compiled into source code.

# GA4 Data API — server only. Property ID is numeric, NOT the G- Measurement ID.
GA4_PROPERTY_ID=
# Numeric website Stream ID (not G- Measurement ID), required for realtime.
GA4_WEB_STREAM_ID=
# Preferred: absolute path to a service-account JSON Secret File (runtime only).
# Render: /etc/secrets/<filename>. Do not place the JSON in the repository/public/.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional legacy alternative, used ONLY when GOOGLE_APPLICATION_CREDENTIALS is unset.
# Base64 of the service account JSON. Never prefix either credential with NEXT_PUBLIC_.
GA4_SERVICE_ACCOUNT_JSON_BASE64=
# Comma-separated exact website hostnames (exclude app/localhost traffic).
GA4_HOSTNAMES=bbookmakeup.com,www.bbookmakeup.com
